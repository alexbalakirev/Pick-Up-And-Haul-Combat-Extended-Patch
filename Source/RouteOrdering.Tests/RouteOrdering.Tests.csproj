<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\RouteOrdering.cs')">
    <DefineConstants>$(DefineConstants);HAS_ROUTE_ORDERING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\HarmonyTargetDiscovery.cs')">
    <DefineConstants>$(DefineConstants);HAS_HARMONY_TARGET_DISCOVERY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\AdaptiveStorageReservationPolicy.cs')">
    <DefineConstants>$(DefineConstants);HAS_ADAPTIVE_STORAGE_RESERVATION_POLICY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\CandidateSelection.cs')">
    <DefineConstants>$(DefineConstants);HAS_CANDIDATE_SELECTION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\PartialPickupPolicy.cs')">
    <DefineConstants>$(DefineConstants);HAS_PARTIAL_PICKUP_POLICY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\CapacityMath.cs')">
    <DefineConstants>$(DefineConstants);HAS_CAPACITY_MATH</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\UnloadDestinationCache.cs')">
    <DefineConstants>$(DefineConstants);HAS_UNLOAD_DESTINATION_CACHE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\AdaptiveStorageTypeMemo.cs')">
    <DefineConstants>$(DefineConstants);HAS_ADAPTIVE_TYPE_MEMO</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\RouteOrdering.cs')">
    <Compile Include="..\RouteOrdering.cs" Link="RouteOrdering.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\HarmonyTargetDiscovery.cs')">
    <Compile Include="..\HarmonyTargetDiscovery.cs" Link="HarmonyTargetDiscovery.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\AdaptiveStorageReservationPolicy.cs')">
    <Compile Include="..\AdaptiveStorageReservationPolicy.cs" Link="AdaptiveStorageReservationPolicy.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\CandidateSelection.cs')">
    <Compile Include="..\CandidateSelection.cs" Link="CandidateSelection.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\PartialPickupPolicy.cs')">
    <Compile Include="..\PartialPickupPolicy.cs" Link="PartialPickupPolicy.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\CapacityMath.cs')">
    <Compile Include="..\CapacityMath.cs" Link="CapacityMath.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\UnloadDestinationCache.cs')">
    <Compile Include="..\UnloadDestinationCache.cs" Link="UnloadDestinationCache.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\AdaptiveStorageTypeMemo.cs')">
    <Compile Include="..\AdaptiveStorageTypeMemo.cs" Link="AdaptiveStorageTypeMemo.cs" />
  </ItemGroup>

</Project>
